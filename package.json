{
  "name": "listing-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"node --watch --env-file-if-exists=.env server/index.mjs\" \"vite --host 127.0.0.1\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node scripts/validate-live-deepseek.mjs",
    "test:e2e": "node scripts/validate-live-browser.mjs",
    "format": "prettier --write src server tests *.ts",
    "test:legacy-mocked": "node --test tests/*.test.mjs",
    "test:e2e:legacy-mocked": "playwright test",
    "test:live": "node scripts/validate-live-deepseek.mjs --real-api",
    "test:live:browser": "node scripts/validate-live-browser.mjs --real-api",
    "test:live:evidence": "node scripts/validate-live-evidence.mjs --real-api",
    "test:live:library": "node scripts/validate-live-library.mjs",
    "test:flat-file": "node scripts/validate-flat-file.mjs",
    "test:live:flat-file": "node scripts/validate-live-flat-file.mjs",
    "test:live:flat-file:browser": "node scripts/validate-live-flat-file-browser.mjs",
    "test:live:handoff": "node scripts/validate-live-handoff.mjs --real-api",
    "package:share": "node scripts/package-share.mjs",
    "export:platform": "node scripts/export-platform.mjs",
    "export:platform:check": "node scripts/export-platform.mjs --check",
    "audit:delivery": "node scripts/delivery-audit.mjs --strict --self-test",
    "audit:delivery:run": "node scripts/delivery-audit.mjs --run --self-test",
    "test:live:parameters": "node scripts/validate-live-parameters.mjs --real-api",
    "test:parameters": "node scripts/validate-parameter-links.mjs",
    "test:merchant-facts": "node scripts/validate-merchant-facts.mjs",
    "test:live:merchant": "node scripts/validate-live-merchant.mjs --real-api",
    "test:live:merchant:followup": "node scripts/validate-live-merchant-followup.mjs --real-api",
    "rules:doc": "node scripts/explain-rules.mjs --write",
    "rules:check": "node scripts/explain-rules.mjs --check",
    "test:integration": "node --test tests/parameter-integration.test.mjs tests/integration-report.test.mjs tests/integration-batch-ops.test.mjs tests/integration-provider-metadata.test.mjs",
    "test:live:integration": "node scripts/validate-live-integration.mjs --real-api",
    "test:live:integration:followup": "node scripts/validate-live-integration-followup.mjs --real-api",
    "a11y:keys": "node scripts/keyboard-probe.mjs",
    "a11y:keys:strict": "node scripts/keyboard-probe.mjs --strict",
    "probe:config": "node scripts/config-error-probe.mjs",
    "probe:config:ui": "node scripts/config-error-probe.mjs --ui",
    "probe:confirm": "node scripts/batch-confirm-probe.mjs",
    "probe:cold": "node scripts/cold-start-probe.mjs",
    "probe:prohibited": "node scripts/prohibited-scan.mjs --list --nearmiss",
    "probe:prompt": "node scripts/generation-contract.mjs",
    "probe:prompt:strict": "node scripts/generation-contract.mjs --strict",
    "probe:shape": "node scripts/generation-shape-probe.mjs",
    "probe:privacy": "node scripts/privacy-probe.mjs",
    "probe:privacy:strict": "node scripts/privacy-probe.mjs --strict",
    "probe:claims": "node scripts/claim-recall-probe.mjs --candidates",
    "probe:claims:strict": "node scripts/claim-recall-probe.mjs --strict",
    "probe:claims:gate": "node scripts/claim-recall-probe.mjs --gate-check",
    "probe:claims:layout": "node scripts/claim-copy-layout.mjs --strict",
    "probe:real": "node scripts/real-listing-probe.mjs --profile",
    "probe:offline": "node scripts/offline-report-probe.mjs",
    "probe:offline:strict": "node scripts/offline-report-probe.mjs --strict",
    "probe:xlsx": "node scripts/xlsx-probe.mjs",
    "probe:xlsx:strict": "node scripts/xlsx-probe.mjs --strict",
    "probe:print": "node scripts/print-probe.mjs",
    "probe:print:strict": "node scripts/print-probe.mjs --strict",
    "probe:scale": "node scripts/batch-scale-probe.mjs",
    "probe:scale:micro": "node scripts/batch-scale-probe.mjs --micro",
    "probe:scale:strict": "node scripts/batch-scale-probe.mjs --strict",
    "probe:cost": "node scripts/batch-cost-probe.mjs",
    "probe:cost:strict": "node scripts/batch-cost-probe.mjs --strict",
    "demo:timing": "node scripts/demo-timing.mjs",
    "fair:prepare": "node --env-file-if-exists=.env scripts/prepare-fair-rehearsal.mjs",
    "fair:build": "node scripts/build-fair-rehearsal.mjs",
    "fair:check": "node scripts/validate-fair-rehearsal.mjs",
    "demo:walk": "node scripts/demo-walk.mjs",
    "demo:drill": "node scripts/failure-drill.mjs --ui",
    "demo:check": "npm run build && node scripts/demo-timing.mjs --mode prod --runs 1 && node scripts/demo-walk.mjs && node scripts/failure-drill.mjs",
    "probe:start": "node scripts/start-local-probe.mjs",
    "probe:start:strict": "node scripts/start-local-probe.mjs --strict",
    "probe:eval": "node scripts/eval-set-probe.mjs",
    "probe:eval:strict": "node scripts/eval-set-probe.mjs --strict",
    "probe:advice": "node scripts/worklist-advice-probe.mjs",
    "probe:advice:batch": "node scripts/batch-advice-probe.mjs",
    "probe:advice:strict": "node scripts/worklist-advice-probe.mjs --strict",
    "test:intake": "node --test tests/intake.test.mjs tests/intake-parser.test.mjs tests/fabric-weight-context.test.mjs tests/intake-dimensions.test.mjs",
    "test:live:intake": "node scripts/validate-live-intake.mjs --real-api",
    "test:live:intake:browser": "node scripts/validate-live-intake-browser.mjs --real-api",
    "test:guided": "node --test tests/guided.test.mjs tests/research-source-grounding.test.mjs tests/official-references.test.mjs",
    "test:live:guided": "node scripts/validate-live-guided.mjs --real-api",
    "test:live:guided:browser": "node scripts/validate-live-guided-browser.mjs --real-api",
    "test:materials": "node --test tests/materials.test.mjs tests/amazon-template-import.test.mjs",
    "test:live:materials": "node scripts/validate-live-materials.mjs --real-api",
    "test:live:rule-monitor:browser": "node scripts/validate-live-rule-monitor-browser.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "cheerio": "^1.2.0",
    "exceljs": "4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "1.61.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
