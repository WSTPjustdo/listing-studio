# Real inference is required. Configure a private key locally; no demonstration fallback.
MODEL_PROVIDER=compatible
PORT=8787
HOST=127.0.0.1

# Generic chat-completions compatible provider; configure on the local settings page.
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_NAME=deepseek-flash

# Dify workflow adapter: input variable `request_json`, output variable `result_json`.
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_CREATE_API_KEY=
DIFY_DIAGNOSE_API_KEY=
MODEL_TIMEOUT_MS=60000
# Optional product research APIs. Configure in the research workspace or here.
RAINFOREST_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
