      "note": "关键词仅用于召回；否定、引用、限定条件和上下文影响判断。"
    },
    {
      "rule_id": "US-02",
      "category": "target_country_claims_review",
      "title_zh": "降解宣称的证据与条件",
      "field_paths": [
        "content"
      ],
      "scope": {
