  "rules": [
    {
      "rule_id": "AMZ-01",
      "category": "platform_rules",
      "title_zh": "标题长度",
      "field_paths": [
        "content.title"
      ],
      "scope": {
        "marketplace": "US",
        "media_product": false
      },
      "constraint": {
        "max_characters": 75,
        "include_spaces": true,
        "application_counting": "unicode_code_points"
      },
      "effective_from": "2026-07-27",
      "method": "deterministic",
      "severity_on_failure": "blocking",
      "source_ids": [
        "AMZS-TITLE-2026"
      ],
      "repair": "提出更短的标题，不加入新事实，重新计数。"
    },
    {
      "rule_id": "AMZ-02",
      "category": "platform_rules",
      "title_zh": "亮点长度",
      "field_paths": [
        "content.item_highlights"
      ],
      "scope": {
        "marketplace": "US",
        "media_product": false
      },
      "constraint": {
        "max_characters": 125,
        "include_spaces": true,
        "application_counting": "unicode_code_points"
      },
      "effective_from": "2026-07-27",
      "method": "deterministic",
      "severity_on_failure": "blocking",
      "source_ids": [
        "AMZS-TITLE-2026"
      ],
      "repair": "提炼信息，必要时移到其他适用字段，重新计数。"
    },
    {
      "rule_id": "AMZ-03",
      "category": "platform_rules",
      "title_zh": "文案中的联系信息或链接",
      "field_paths": [
        "content.title",
        "content.item_highlights",
        "content.bullet_points[].text",
        "content.description"
      ],
      "field_basis_overrides": {
        "content.item_highlights": {
          "kind": "project_check",
          "source_ids": [
            "PROJECT-AMAZON-QUALITY"
          ],
          "note": "本应用保守沿用文案限制，待亮点字段具体规则核实；不作为独立官方规则计数。"
        }
      },
      "scope": {
        "marketplace": "US"
      },
      "constraint": {
        "candidates": [
          "email_address",
          "phone_number",
          "seller_address",
          "website_url"
        ]
      },
      "method": "patterns_with_context_review",
      "severity_on_failure": "blocking",
      "source_ids": [
        "AMZS-DETAIL-US"
      ],
      "repair": "删除受限文案中的联系信息；内部证据链接不属于检查对象。",
      "note": "尺寸数字不因形状相似而自动判为电话号码。"
    },
    {
      "rule_id": "AMZ-04",
      "category": "platform_rules",
      "title_zh": "文案中的交易信息",
