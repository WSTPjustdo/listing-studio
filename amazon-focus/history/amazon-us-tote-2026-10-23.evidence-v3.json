            "PROJECT-AMAZON-QUALITY"
          ],
          "note": "本应用保守沿用文案限制，待亮点字段具体规则核实；不作为独立官方规则计数。"
        }
      },
      "scope": {
        "marketplace": "US"
      },
      "constraint": {
        "candidates": [
          "price",
          "availability",
          "condition",
          "alternative_shipping_offer"
