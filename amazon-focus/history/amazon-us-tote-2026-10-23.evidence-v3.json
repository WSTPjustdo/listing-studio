      "method": "patterns_and_semantic_review",
      "severity_on_failure": "blocking",
      "source_ids": [
        "AMZS-DETAIL-US"
      ],
      "repair": "移除文案中的交易信息，专门的售价或库存字段不适用此规则。"
    },
    {
      "rule_id": "AMZ-05",
      "category": "platform_rules",
      "title_zh": "商品描述准确性",
      "field_paths": [
        "content"
      ],
      "scope": {
        "marketplace": "US"
      },
      "constraint": {
        "must_match_confirmed_product_facts": true
      },
      "method": "structured_comparison_and_semantic_review",
      "severity_on_failure": "blocking",
